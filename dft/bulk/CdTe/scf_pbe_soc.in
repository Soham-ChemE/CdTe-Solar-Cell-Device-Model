&control
  calculation = 'scf'
  prefix = 'CdTe_pbe_soc'
  outdir = './tmp'
  pseudo_dir = '/Users/thegreat/Documents/MATLAB/cdte-device-model/dft/pseudo/fr/nc-fr-04_pbe_standard'
/
&system
  ibrav = 2
  celldm(1) = 12.24732
  nat = 2
  ntyp = 2
  ecutwfc = 80
  nbnd = 52
  noncolin = .true.
  lspinorb = .true.
/
&electrons
  conv_thr = 1.0d-9
/
ATOMIC_SPECIES
  Cd 112.414 Cd.upf
  Te 127.6 Te.upf
ATOMIC_POSITIONS crystal
  Cd 0.00 0.00 0.00
  Te 0.25 0.25 0.25
K_POINTS automatic
  8 8 8 0 0 0
